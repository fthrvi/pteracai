{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/data/bank.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "functions": {
    "api/request.js": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": { "main": true }
  }
}
